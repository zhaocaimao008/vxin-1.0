# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=vxin
DB_PASSWORD=changeme
DB_DATABASE=vxin

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── AI service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000

# ── Push notifications (optional) ─────────────────────────────────────────────
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
