{
  "name": "v信",
  "short_name": "v信",
  "description": "安全、高效的企业级即时通讯",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#F5F6F2",
  "theme_color": "#F5F6F2",
  "orientation": "portrait-primary",
  "lang": "zh-CN",
  "scope": "./",
  "id": "com.vxin.app",
  "icons": [
    {
      "src": "./icons/icon-192.png?v=20261009b",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png?v=20261009b",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-192.png?v=20261009b",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/maskable-512.png?v=20261009b",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./favicon.svg?v=20261009b",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "新消息",
      "short_name": "消息",
      "description": "查看最新消息",
      "url": "./?tab=chat",
      "icons": [
        {
          "src": "./icons/icon-192.png?v=20261009b",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "通讯录",
      "short_name": "通讯录",
      "description": "查看联系人",
      "url": "./?tab=contacts",
      "icons": [
        {
          "src": "./icons/icon-192.png?v=20261009b",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "朋友圈",
      "short_name": "朋友圈",
      "description": "浏览朋友圈动态",
      "url": "./?tab=moments",
      "icons": [
        {
          "src": "./icons/icon-192.png?v=20261009b",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            ".pdf",
            ".doc",
            ".docx"
          ]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+vxin",
      "url": "/open?uri=%s"
    }
  ],
  "categories": [
    "social",
    "communication"
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  }
}
